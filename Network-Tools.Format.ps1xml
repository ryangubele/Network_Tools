<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <ViewDefinitions>
    <View>
      <Name>NetworkToolsScanResultTable</Name>
      <ViewSelectedBy>
        <TypeName>NetworkTools.ScanResult</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <AutoSize />
        <TableHeaders>
          <TableColumnHeader>
            <Label>Hostname</Label>
            <Width>30</Width>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>IPAddress</Label>
            <Width>15</Width>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>MACAddress</Label>
            <Width>17</Width>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>MACVendor</Label>
            <Width>40</Width>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>LatencyMs</Label>
            <Width>9</Width>
          </TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem>
                <PropertyName>Hostname</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>IPAddress</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>MACAddress</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>MACVendor</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>LatencyMs</PropertyName>
              </TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>NetworkToolsSnmpInterfaceTable</Name>
      <ViewSelectedBy>
        <TypeName>NetworkTools.SnmpInterface</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <AutoSize />
        <TableHeaders>
          <TableColumnHeader><Label>Index</Label></TableColumnHeader>
          <TableColumnHeader><Label>Name</Label></TableColumnHeader>
          <TableColumnHeader><Label>Alias</Label></TableColumnHeader>
          <TableColumnHeader><Label>Status</Label></TableColumnHeader>
          <TableColumnHeader><Label>SpeedMbps</Label></TableColumnHeader>
          <TableColumnHeader><Label>InRate</Label></TableColumnHeader>
          <TableColumnHeader><Label>OutRate</Label></TableColumnHeader>
          <TableColumnHeader><Label>InErrors</Label></TableColumnHeader>
          <TableColumnHeader><Label>OutErrors</Label></TableColumnHeader>
          <TableColumnHeader><Label>InDiscards</Label></TableColumnHeader>
          <TableColumnHeader><Label>OutDiscards</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Index</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Name</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Alias</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>OperStatus</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>SpeedMbps</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>InRate</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>OutRate</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>InErrors</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>OutErrors</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>InDiscards</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>OutDiscards</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
  </ViewDefinitions>
</Configuration>
